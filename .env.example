# Optional: enables Gemma-powered expense draft extraction.
# Create a key in Google AI Studio, copy this file to .env.local, and add the key.
GEMINI_API_KEY=

# Optional. The default hosted Gemma model is gemma-4-26b-a4b-it.
GEMMA_MODEL=gemma-4-26b-a4b-it

# Optional: shared accounts and database. Run supabase/schema.sql first.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Optional automated WhatsApp reminders: run supabase/reminders.sql.
# Server-only keys; never put the service-role key in browser code.
SUPABASE_SERVICE_ROLE_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_CONTENT_SID=
CRON_SECRET=
APP_URL=https://koottu-shared-flat-ledger.vercel.app
